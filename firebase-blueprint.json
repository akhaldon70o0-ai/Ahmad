{
  "entities": {
    "storeData": {
      "title": "Store Data",
      "description": "Synchronized store inventory, sales, customers, orders, users, and progress across all devices",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Store partition identifier" },
        "updatedAt": { "type": "string", "description": "Last updated ISO timestamp" },
        "updatedBy": { "type": "string", "description": "User or device that last committed changes" },
        "inventory": { "type": "array", "description": "Product catalog and stock counts" },
        "sales": { "type": "array", "description": "Sales ledger records and receipts" },
        "customers": { "type": "array", "description": "Customer profiles and debt ledger" },
        "customerPayments": { "type": "array", "description": "Customer debt payment logs" },
        "users": { "type": "array", "description": "Staff and admin user accounts" },
        "dailyOrders": { "type": "array", "description": "Daily supplier orders" },
        "expenses": { "type": "array", "description": "Store operational expense records" },
        "bundles": { "type": "array", "description": "Product bundle packages" },
        "coupons": { "type": "array", "description": "Discounts and coupon codes" },
        "settings": { "type": "object", "description": "Store configuration and preferences" },
        "activities": { "type": "array", "description": "Audit log and store activity timeline" },
        "purchases": { "type": "array", "description": "Purchase orders" },
        "writeOffs": { "type": "array", "description": "Inventory write-offs" },
        "returnsLog": { "type": "array", "description": "Product returns" },
        "stockMovements": { "type": "array", "description": "Stock movements log" },
        "dailyClosures": { "type": "array", "description": "Register shift and daily closure reports" }
      },
      "required": ["id"]
    },
    "users": {
      "title": "User Accounts",
      "description": "User profiles for cloud multi-device authentication",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "pin": { "type": "string" },
        "passwordHash": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLogin": { "type": "string" }
      },
      "required": ["id", "username"]
    },
    "storeMeta": {
      "title": "Store Metadata",
      "description": "Store account profile and configuration registered to owner email",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "ownerName": { "type": "string" },
        "currency": { "type": "string" },
        "adminPin": { "type": "string" },
        "passwordHash": { "type": "string" },
        "passwordSalt": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastActive": { "type": "string" }
      },
      "required": ["id", "name", "ownerEmail"]
    },
    "storeUser": {
      "title": "Store User Lookup Index",
      "description": "Fast lookup index mapping user email/username to their isolated storeId",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "username": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "storeId": { "type": "string" },
        "storeName": { "type": "string" },
        "passwordHash": { "type": "string" },
        "passwordSalt": { "type": "string" },
        "pin": { "type": "string" }
      },
      "required": ["email", "storeId"]
    },
    "storeAccessRequest": {
      "title": "Store Access Request",
      "description": "Store license and creation requests submitted by prospective merchants for administrator approval",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessName": { "type": "string" },
        "contactName": { "type": "string" },
        "contactEmail": { "type": "string" },
        "contactPhone": { "type": "string" },
        "currency": { "type": "string" },
        "status": { "type": "string" },
        "requestedAt": { "type": "string" }
      },
      "required": ["id", "businessName", "contactEmail", "status"]
    },
    "activationCode": {
      "title": "Activation License Code",
      "description": "License keys generated by master admin to authorize new store creation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "isUsed": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "code", "isUsed"]
    },
    "ownerVerificationCode": {
      "title": "Owner Verification OTP Code",
      "description": "One-time passcode sent to the platform owner email to authorize master platform login",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "code": { "type": "string" },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "string" },
        "isUsed": { "type": "boolean" }
      },
      "required": ["email", "code", "expiresAt"]
    }
  },
  "firestore": {
    "stores/{storeId}": {
      "schema": "storeMeta",
      "description": "Directory of registered stores partitioned by unique storeId"
    },
    "store_users/{emailClean}": {
      "schema": "storeUser",
      "description": "Directory index mapping user emails to their specific store account"
    },
    "store_data/{storeId}": {
      "schema": "storeData",
      "description": "Synchronized store ledger state across all devices for this specific store partition"
    },
    "store_requests/{requestId}": {
      "schema": "storeAccessRequest",
      "description": "Submitted store access authorization requests"
    },
    "activation_codes/{codeId}": {
      "schema": "activationCode",
      "description": "Active and redeemed store creation authorization keys"
    },
    "owner_verification_codes/{emailClean}": {
      "schema": "ownerVerificationCode",
      "description": "Stored one-time verification codes for platform owner authentication"
    },
    "mail/{mailId}": {
      "schema": "object",
      "description": "Trigger Email delivery queue"
    },
    "users/{userId}": {
      "schema": "users",
      "description": "User accounts accessible across all devices"
    }
  }
}
